  {
   "id": "magic-schools",
   "name": "Schools of Magic",
   "name_it": "Scuole di magia",
   "source": "SRD 5.1",
   "sources": [
    "SRD 5.1",
    "SRD 5.2"
   ],
   "rows": [
    {
     "id": "abjuration",
     "name": "Abjuration",
     "name_it": "Abiurazione",
     "desc": "Abjuration spells are protective in nature, though some of them have aggressive uses. They create magical barriers, negate harmful effects, harm trespassers, or banish creatures to other planes of existence.",
     "desc2024": "Prevents or reverses harmful effects"
    },
    {
     "id": "conjuration",
     "name": "Conjuration",
     "name_it": "Evocazione",
     "desc": "Conjuration spells involve the transportation of objects and creatures from one location to another. Some spells summon creatures or objects to the caster's side, whereas others allow the caster to teleport to another location. Some conjurations create objects or effects out of nothing.",
     "desc2024": "Transports creatures or objects"
    },
    {
     "id": "divination",
     "name": "Divination",
     "name_it": "Divinazione",
     "desc": "Divination spells reveal information, whether in the form of secrets long forgotten, glimpses of the future, the locations of hidden things, the truth behind illusions, or visions of distant people or places.",
     "desc2024": "Reveals information"
    },
    {
     "id": "enchantment",
     "name": "Enchantment",
     "name_it": "Ammaliamento",
     "desc": "Enchantment spells affect the minds of others, influencing or controlling their behavior. Such spells can make enemies see the caster as a friend, force creatures to take a course of action, or even control another creature like a puppet.",
     "desc2024": "Influences minds"
    },
    {
     "id": "evocation",
     "name": "Evocation",
     "name_it": "Invocazione",
     "desc": "Evocation spells manipulate magical energy to produce a desired effect. Some call up blasts of fire or lightning. Others channel positive energy to heal wounds.",
     "desc2024": "Channels energy to create effects that are often destructive"
    },
    {
     "id": "illusion",
     "name": "Illusion",
     "name_it": "Illusione",
     "desc": "Illusion spells deceive the senses or minds of others. They cause people to see things that are not there, to miss things that are there, to hear phantom noises, or to remember things that never happened. Some illusions create phantom images that any creature can see, but the most insidious illusions plant an image directly in the mind of a creature.",
     "desc2024": "Deceives the mind or senses"
    },
    {
     "id": "necromancy",
     "name": "Necromancy",
     "name_it": "Necromanzia",
     "desc": "Necromancy spells manipulate the energies of life and death. Such spells can grant an extra reserve of life force, drain the life energy from another creature, create the undead, or even bring the dead back to life.",
     "desc2024": "Manipulates life and death"
    },
    {
     "id": "transmutation",
     "name": "Transmutation",
     "name_it": "Trasmutazione",
     "desc": "Transmutation spells change the properties of a creature, object, or environment. They might turn an enemy into a harmless creature, bolster the strength of an ally, make an object move at the caster's command, or enhance a creature's innate healing abilities to rapidly recover from injury.",
     "desc2024": "Transforms creatures or objects"
    }
   ]
  },
  {
   "id": "alignments",
   "name": "Alignments",
   "name_it": "Allineamenti",
   "source": "SRD 5.1",
   "sources": [
    "SRD 5.1",
    "SRD 5.2"
   ],
   "rows": [
    {
     "id": "lawful-good",
     "name": "Lawful Good",
     "abbr": "LG",
     "name_it": "Legale Buono",
     "desc": "Lawful good (LG) creatures can be counted on to do the right thing as expected by society. Gold dragons, paladins, and most dwarves are lawful good.",
     "desc2024": "Lawful Good creatures endeavor to do the right thing as expected by society. Someone who fights injustice and protects the innocent without hesitation is probably Lawful Good."
    },
    {
     "id": "neutral-good",
     "name": "Neutral Good",
     "abbr": "NG",
     "name_it": "Neutrale Buono",
     "desc": "Neutral good (NG) folk do the best they can to help others according to their needs. Many celestials, some cloud giants, and most gnomes are neutral good.",
     "desc2024": "Neutral Good creatures do the best they can, working within rules but not feeling bound by them. A kindly person who helps others according to their needs is probably Neutral Good."
    },
    {
     "id": "chaotic-good",
     "name": "Chaotic Good",
     "abbr": "CG",
     "name_it": "Caotico Buono",
     "desc": "Chaotic good (CG) creatures act as their conscience directs, with little regard for what others expect. Copper dragons, many elves, and unicorns are chaotic good.",
     "desc2024": "Chaotic Good creatures act as their conscience directs with little regard for what others expect. A rebel who waylays a cruel baron's tax collectors and uses the stolen money to help the poor is probably Chaotic Good."
    },
    {
     "id": "lawful-neutral",
     "name": "Lawful Neutral",
     "abbr": "LN",
     "name_it": "Legale Neutrale",
     "desc": "Lawful neutral (LN) individuals act in accordance with law, tradition, or personal codes. Many monks and some wizards are lawful neutral.",
     "desc2024": "Lawful Neutral individuals act in accordance with law, tradition, or personal codes. Someone who follows a disciplined rule of life—and isn't swayed either by the demands of those in need or by the temptations of evil—is probably Lawful Neutral."
    },
    {
     "id": "neutral",
     "name": "Neutral",
     "abbr": "N",
     "name_it": "Neutrale",
     "desc": "Neutral (N) is the alignment of those who prefer to steer clear of moral questions and don't take sides, doing what seems best at the time. Lizardfolk, most druids, and many humans are neutral.",
     "desc2024": "Neutral is the alignment of those who prefer to avoid moral questions and don't take sides, doing what seems best at the time. Someone who's bored by moral debate is probably Neutral."
    },
    {
     "id": "chaotic-neutral",
     "name": "Chaotic Neutral",
     "abbr": "CN",
     "name_it": "Caotico Neutrale",
     "desc": "Chaotic neutral (CN) creatures follow their whims, holding their personal freedom above all else. Many barbarians and rogues, and some bards, are chaotic neutral.",
     "desc2024": "Chaotic Neutral creatures follow their whims, valuing their personal freedom above all else. A scoundrel who wanders the land living by their wits is probably Chaotic Neutral."
    },
    {
     "id": "lawful-evil",
     "name": "Lawful Evil",
     "abbr": "LE",
     "name_it": "Legale Malvagio",
     "desc": "Lawful evil (LE) creatures methodically take what they want, within the limits of a code of tradition, loyalty, or order. Devils, blue dragons, and hobgoblins are lawful evil.",
     "desc2024": "Lawful Evil creatures methodically take what they want within the limits of a code of tradition, loyalty, or order. An aristocrat exploiting citizens while scheming for power is probably Lawful Evil."
    },
    {
     "id": "neutral-evil",
     "name": "Neutral Evil",
     "abbr": "NE",
     "name_it": "Neutrale Malvagio",
     "desc": "Neutral evil (NE) is the alignment of those who do whatever they can get away with, without compassion or qualms. Many drow, some cloud giants, and goblins are neutral evil.",
     "desc2024": "Neutral Evil is the alignment of those who are untroubled by the harm they cause as they pursue their desires. A criminal who robs and murders as they please is probably Neutral Evil."
    },
    {
     "id": "chaotic-evil",
     "name": "Chaotic Evil",
     "abbr": "CE",
     "name_it": "Caotico Malvagio",
     "desc": "Chaotic evil (CE) creatures act with arbitrary violence, spurred by their greed, hatred, or bloodlust. Demons, red dragons, and orcs are chaotic evil.",
     "desc2024": "Chaotic Evil creatures act with arbitrary violence, spurred by their hatred or bloodlust. A villain pursuing schemes of vengeance and havoc is probably Chaotic Evil."
    },
    {
     "id": "unaligned",
     "name": "Unaligned",
     "abbr": "U",
     "name_it": "Senza allineamento",
     "desc": "",
     "desc2024": "Most creatures that lack the capacity for rational thought don't have alignments; they are unaligned. Sharks are savage predators, for example, but they aren't evil; they are unaligned."
    }
   ]
  },
